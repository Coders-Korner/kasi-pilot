# Copy to .env and fill in your values.

# Local development database (SQLite).
# For Supabase/Postgres: set provider to postgresql in prisma/schema.prisma and use:
# DATABASE_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=15"

# Used to sign session JWTs. Use a long random string in production.
SESSION_SECRET="change-me"

# OpenAI (optional). Without a key the app uses the deterministic rule-based parser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Simulated OTP flow. When "1", the OTP is returned in API responses and logs (demo only).
OTP_DEV_MODE="1"