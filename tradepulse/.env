# Local development database (SQLite). For Supabase/Postgres deployment change the
# provider in prisma/schema.prisma to postgresql and set DATABASE_URL to your connection string.
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=15"

# Secrets (dev only - never commit real values)
SESSION_SECRET="dev-secret-change-me-9f8e7d6c5b4a39281706"

# OpenAI config. Leave OPENAI_API_KEY unset to run entirely on the offline rule-based parser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# When set to "1", the simulated OTP is returned in API responses and console for the demo.
OTP_DEV_MODE="1"